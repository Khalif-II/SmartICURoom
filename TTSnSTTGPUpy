from flask import Flask, request, jsonify, send_file
import whisper
from TTS.api import TTS
import os

app = Flask(__name__)


whisper_model = whisper.load_model("base")  
tts_model = TTS(model_name="tts_models/en/ljspeech/tacotron2-DDC", progress_bar=False, gpu=True)  


os.environ["PATH"] += os.pathsep + r"C:\Users\khali\Downloads\ffmpeg-master-latest-win64-gpl\bin"

@app.route('/tts', methods=['POST'])
def text_to_speech():
    data = request.get_json()
    texts = data.get("text", [])

   
    if isinstance(texts, str):
        texts = [texts]

    combined_text = " ".join(texts)  
    output_path = "output_audio.wav"

    
    tts_model.tts_to_file(text=combined_text, file_path=output_path)
    return send_file(output_path, mimetype="audio/wav", as_attachment=True, download_name="output.wav")

@app.route('/stt', methods=['POST'])
def speech_to_text():
    """Convert speech to text."""
    audio_file = request.files['audio']
    temp_path = "temp_audio.wav"
    
    
    audio_file.save(temp_path)

    
    result = whisper_model.transcribe(temp_path)
    os.remove(temp_path)  

    
    return jsonify({"transcription": result['text']})

if __name__ == '__main__':
    app.run(host="0.0.0.0", port=5009)
