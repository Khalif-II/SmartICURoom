    private void MoveObjectBeside(string objectToMove, string referenceObject)
    {
        if (sceneObjects.ContainsKey(objectToMove) && sceneObjects.ContainsKey(referenceObject))
        {
            GameObject objToMove = sceneObjects[objectToMove];
            GameObject refObj = sceneObjects[referenceObject];

            
            Vector3 offsetPosition = refObj.transform.position + Vector3.right * 2;
            objToMove.transform.position = offsetPosition;

            
        }
        else
        {
           
        }
    }
    private void HighlightObject(string objectName)
    {
        if (sceneObjects.ContainsKey(objectName))
        {
            GameObject obj = sceneObjects[objectName];
            Renderer renderer = obj.GetComponent<Renderer>();
            if (renderer != null)
            {
                renderer.material.color = Color.yellow; 
                
            }
        }
        
    }



    private string[] GetObjectsFromCommand(string command, string startKeyword, string separator)
    {
        int startIndex = command.IndexOf(startKeyword) + startKeyword.Length;
        int endIndex = command.IndexOf(separator, startIndex);
        if (startIndex >= 0 && endIndex > startIndex)
        {
            string objectPhrase = command.Substring(startIndex, endIndex - startIndex).Trim();
            return objectPhrase.Split(new string[] { " and ", " with ", "," }, System.StringSplitOptions.RemoveEmptyEntries);
        }
        return new string[0];
    }

    [System.Serializable]
    public class OpenAIResponse
    {
        public Choice[] choices;

        [System.Serializable]
        public class Choice
        {
            public Message message;
        }

        [System.Serializable]
        public class Message
        {
            public string role;
            public string content;
        }
    }

