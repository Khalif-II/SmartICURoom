    private async void ProcessDataRequest(string dataType)
    {
        if (dataType == "Patient History" || dataType.ToLower().Contains("history"))
        {
            
            if (patientHistoryGenerator != null)
            {
                string history = patientHistoryGenerator.GetPatientHistory();
                if (!string.IsNullOrEmpty(history))
                {
                    aiResponseText.text = history; 
                    await RespondWithText(history); 
                    return;
                }
                else
                {
                    aiResponseText.text = "I'm sorry, I couldn't retrieve the patient history.";
                    
                }
            }
            else
            {
                aiResponseText.text = "Patient history generator is not assigned.";
               
            }
            return;
        }

        TMP_Text dataElement = patientDataManager.GetDataElement(dataType.ToLower());

        if (dataElement != null)
        {
            HighlightDataElement(dataElement);
            string responseText = $" {dataType}  {dataElement.text}.";
            aiResponseText.text = " " + responseText;
            await RespondWithText(responseText);
        }
        else
        {
            aiResponseText.text = $"I'm sorry, I couldn't find information on {dataType}.";
            
        }
    }
    private void HighlightDataElement(TMP_Text dataElement)
    {
        
        originalColor = dataElement.color;

        
        dataElement.color = highlightColor;

        
        Invoke("ResetHighlight", 3f);
    }

    
    private void ResetHighlight()
    {
        foreach (var element in patientDataManager.dataElements.Values)
        {
            element.color = originalColor;
        }
    }

    


    public async Task<string> SendToOpenAI(string query)
    {
      

        using (HttpClient client = new HttpClient())
        {
            client.DefaultRequestHeaders.Add("Authorization", $"Bearer {openAIApiKey}");

            
            var requestBody = new
            {
                model = "gpt-3.5-turbo",
                messages = new[]
                {
                new { role = "system", content = "You are a Unity assistant that interprets commands to interact with objects in a 3D scene. Respond only with actions or object names, not code." },
                new { role = "user", content = query }
            },
                max_tokens = 150,
                temperature = 0.5
            };

            string jsonContent = JsonConvert.SerializeObject(requestBody);
            HttpContent content = new StringContent(jsonContent, Encoding.UTF8, "application/json");

            try
            {
                HttpResponseMessage response = await client.PostAsync("https://api.openai.com/v1/chat/completions", content);
                string result = await response.Content.ReadAsStringAsync();
                

                var responseJson = JsonConvert.DeserializeObject<OpenAIResponse>(result);

                
                if (responseJson?.choices != null && responseJson.choices.Length > 0 && !string.IsNullOrEmpty(responseJson.choices[0].message.content))
                {
                    return responseJson.choices[0].message.content.Trim();
                }
                else
                {
                    
                    return "I'm sorry, I couldn't understand the request. Please try again.";
                }
            }
            catch (System.Exception ex)
            {
               
                return "There was an error processing the request. Please try again later.";
            }
        }
    }


    public void DisplayResponse(string response)
    {
        aiResponseText.text = "AI Assistant: " + response;
    }



    private void ParseAndExecuteCommand(string command)
    {
        

        
        command = command.ToLower();
        command = command.Replace(",", "").Replace(".", "");

        string targetObject = "";
        string referenceObject = "";
        string action = "";

        
        if (command.Contains("ecg"))
        {
            ProcessDataRequest("ECG");
            return;
        }
        else if (command.Contains("heart rate"))
        {
            ProcessDataRequest("Heart rate");
            return;
        }
        else if (command.Contains("respiratory rate"))
        {
            ProcessDataRequest("Respiratory Rate");
            return;
        }
        else if (command.Contains("systolic bp") || command.Contains("systolic blood pressure"))
        {
            ProcessDataRequest("Systolic BP");
            return;
        }
        else if (command.Contains("diastolic bp") || command.Contains("diastolic blood pressure"))
        {
            ProcessDataRequest("Diastolic BP");
            return;
        }
        else if (command.Contains("temperature"))
        {
            ProcessDataRequest("Temperature");
            return;
        }
        else if (command.Contains("oxygen saturation"))
        {
            ProcessDataRequest("Oxygen Saturation");
            return;
        }
        else if (command.Contains("capnogram"))
        {
            ProcessDataRequest("Capnogram");
            return;
        }
        else if (command.Contains("co2"))
        {
            ProcessDataRequest("Co2");
            return;
        }
        else if (command.Contains("mean arterial pressure"))
        {
            ProcessDataRequest("Mean Arterial Pressure");
            return;
        }
        else if (command.Contains("blood volume"))
        {
            ProcessDataRequest("BloodVolume");
            return;
        }
        else if (command.Contains("patient name"))
        {
            ProcessDataRequest("Patient Name");
            return;
        }
        else if (command.Contains("age"))
        {
            ProcessDataRequest("Age");
            return;
        }
        else if (command.Contains("gender"))
        {
            ProcessDataRequest("Gender");
            return;
        }
        else if (command.Contains("contact info") || command.Contains("contact information"))
        {
            ProcessDataRequest("Contact Info");
            return;
        }
        else if (command.Contains("insurance details"))
        {
            ProcessDataRequest("Insurance Details");
            return;
        }
        else if (command.Contains("comorbidities"))
        {
            ProcessDataRequest("Comorbidities Text");
            return;
        }
        else if (command.Contains("family history"))
        {
            ProcessDataRequest("Family History");
            return;
        }
        else if (command.Contains("allergies"))
        {
            ProcessDataRequest("Allergies");
            return;
        }
        else if (command.Contains("genetic risk factors"))
        {
            ProcessDataRequest("Genetic Risk Factors");
            return;
        }
        else if (command.Contains("wbc"))
        {
            ProcessDataRequest("WBC");
            return;
        }
        else if (command.Contains("crp"))
        {
            ProcessDataRequest("CRP");
            return;
        }
        else if (command.Contains("ddimer") || command.Contains("d-dimer"))
        {
            ProcessDataRequest("dDimer");
            return;
        }
        else if (command.Contains("alt"))
        {
            ProcessDataRequest("alt");
            return;
        }
        else if (command.Contains("ast"))
        {
            ProcessDataRequest("ast");
            return;
        }
        else if (command.Contains("pao2"))
        {
            ProcessDataRequest("paO2");
            return;
        }
        else if (command.Contains("creatinine"))
        {
            ProcessDataRequest("Creatinine");
            return;
        }
        else if (command.Contains("paco2"))
        {
            ProcessDataRequest("paCO2");
            return;
        }
        else if (command.Contains("ph"))
        {
            ProcessDataRequest("pH");
            return;
        }
        else if (command.Contains("viral load"))
        {
            ProcessDataRequest("Viral Load");
            return;
        }
        else if (command.Contains("patient history"))
        {
            ProcessDataRequest("Patient History");
            return;
        }
        else if (command.Contains("Chief Complainty"))
        {
            ProcessDataRequest("Chief Complaint");
            return;
        }

        else if (command.Contains("Symptoms"))
        {
            ProcessDataRequest("Symptoms");
            return;
        }

        else if (command.Contains("Relevant History"))
        {
            ProcessDataRequest("Relevant History");
            return;
        }

        else if (command.Contains("Past Medical History"))
        {
            ProcessDataRequest("Past Medical History");
            return;
        }

        else if (command.Contains("Physical Exam"))
        {
            ProcessDataRequest("Physical Exam");
            return;
        }

        else if (command.Contains("Imaging"))
        {
            ProcessDataRequest("Imaging");
            return;
        }
        else if (command.Contains("Assessment and Plan"))
        {
            ProcessDataRequest("Assessment and Plan");
            return;
        }


        if (command.Contains("move") || command.Contains("moving"))
        {
            action = "move";
        }
        else if (command.Contains("highlight") || command.Contains("highlighting"))
        {
            action = "highlight";
        }
        else if (command.Contains("rotate") || command.Contains("rotating"))
        {
            action = "rotate";
        }
        else if (command.Contains("show") || command.Contains("showing"))
        {
            action = "show";
        }
        else if (command.Contains("hide") || command.Contains("hiding"))
        {
            action = "hide";
        }
        else if (command.Contains("scale") || command.Contains("scaling"))
        {
            action = "scale";
        }

        
        foreach (var objName in sceneObjects.Keys)
        {
            if (command.Contains(objName))
            {
                if (string.IsNullOrEmpty(targetObject))
                {
                    targetObject = objName;
                }
                else if (string.IsNullOrEmpty(referenceObject) && objName != targetObject)
                {
                    referenceObject = objName;
                    break;
                }
            }
        }

        
        

       
        if (!string.IsNullOrEmpty(action) && !string.IsNullOrEmpty(targetObject))
        {
            switch (action)
            {
                case "move":
                    if (!string.IsNullOrEmpty(referenceObject))
                    {
                        MoveObjectBeside(targetObject, referenceObject);
                    }
                    else
                    {
                        
                    }
                    break;

                case "highlight":
                    HighlightObject(targetObject);
                    break;

                case "rotate":
                    RotateObject(targetObject, command);
                    break;

                case "show":
                    ShowObject(targetObject);
                    break;

                case "hide":
                    HideObject(targetObject);
                    break;

                case "scale":
                    ScaleObject(targetObject, command);
                    break;

                default:
                    
                    break;
            }
        }
        
        OnAICommandProcessed?.Invoke(command);
    }

    private void ScaleObject(string objectName, string command)
    {
        if (sceneObjects.ContainsKey(objectName))
        {
            GameObject obj = sceneObjects[objectName];
            Vector3 scaleChange = new Vector3(0.1f, 0.1f, 0.1f); 

            
            if (command.Contains("up"))
            {
                obj.transform.localScale += scaleChange; 
               
            }
            else if (command.Contains("down"))
            {
                obj.transform.localScale -= scaleChange; 
               
            }
            else
            {
                
            }
        }
        else
        {
            
        }
    }


    private void RotateObject(string objectName, string command)
    {
        if (sceneObjects.ContainsKey(objectName))
        {
            GameObject obj = sceneObjects[objectName];
            float angle = 45f; 

            
            string[] words = command.Split(' ');
            foreach (string word in words)
            {
                if (float.TryParse(word, out float parsedAngle))
                {
                    angle = parsedAngle;
                    break;
                }
            }

            obj.transform.Rotate(Vector3.up, angle);
            
        }
        else
        {
            
        }
    }

    private void ShowObject(string objectName)
    {
        if (sceneObjects.ContainsKey(objectName))
        {
            GameObject obj = sceneObjects[objectName];
            Renderer renderer = obj.GetComponent<Renderer>();
            if (renderer != null)
            {
                renderer.enabled = true; 
                
            }
        }
        else
        {
           
        }
    }


    private void HideObject(string objectName)
    {
        if (sceneObjects.ContainsKey(objectName))
        {
            GameObject obj = sceneObjects[objectName];
            Renderer renderer = obj.GetComponent<Renderer>();
            if (renderer != null)
            {
                renderer.enabled = false; 
                
            }
        }
        
    }


    
