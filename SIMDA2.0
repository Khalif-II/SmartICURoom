    private SpeechRecognizer speechRecognizer;
    private bool isListeningForCommands = false; 
    private Dictionary<string, GameObject> sceneObjects;
    public GameObject notificationIndicator;

    async void Start()
    {
        Debug.Log("SIMDA AI Voice Assistant is active");

        
        sceneObjects = new Dictionary<string, GameObject>();
        foreach (var obj in GameObject.FindGameObjectsWithTag("Interactable"))
        {
            sceneObjects[obj.name.ToLower()] = obj;
            
        }

        
        if (queryManager != null)
        {
            queryManager.OnResponseReceived += DisplayAIResponse;
        }
        

        try
        {
            var speechConfig = SpeechConfig.FromSubscription(azureSubscriptionKey, azureRegion);
            speechRecognizer = new SpeechRecognizer(speechConfig);

            speechRecognizer.Recognizing += (s, e) => Debug.Log($"Recognizing: {e.Result.Text}");
            speechRecognizer.Recognized += async (s, e) => await ProcessTranscription(e.Result.Text);

            Debug.Log("SIMDA is ready and waiting for the wake word.");
            await speechRecognizer.StartContinuousRecognitionAsync();
        }
        
    }

    
    private void DisplayAIResponse(string response)
    {
        aiResponseText.text = " " + response; 
    }

    
    private void OnDestroy()
    {
        if (queryManager != null)
        {
            queryManager.OnResponseReceived -= DisplayAIResponse;
        }
    }


    public void ProcessTextInputCommand()
    {
        string typedCommand = commandInputField.text;
        if (!string.IsNullOrEmpty(typedCommand))
        {
            
            clinicianText.text = "Clinician: " + typedCommand;

            
            ProcessTranscription(typedCommand);

            
            commandInputField.text = "";
        }
    }


    private async Task ProcessTranscription(string transcription)
    {
        if (string.IsNullOrEmpty(transcription))
        {
          
            return;
        }

        
        clinicianText.text = "Clinician: " + transcription;

        if (transcription.Trim().ToLower() == "simda")
        {
            
            aiResponseText.text = "Yes";
            isListeningForCommands = true;
            return;
        }

        if (transcription.Trim().ToLower() == "that's all")
        {
            D
            aiResponseText.text = "SIMDA: Command mode deactivated.";
            isListeningForCommands = false;
            return;
        }

        if (isListeningForCommands)
        {
           
            
            if (IsDirectDataRequest(transcription))
            {
                
                ProcessDataRequest(ExtractDataType(transcription)); 
                return;
            }

            
            if (IsContextualQuestion(transcription) || IsAdvancedMedicalQuery(transcription))
            {
                
                queryManager.SendAdvancedQuery(transcription); 
                return;
            }

            
            string response = await SendToOpenAI(transcription);
            if (!string.IsNullOrEmpty(response))
            {
                aiResponseText.text = " " + response;
               
                ParseAndExecuteCommand(response); 
            }
            else
            {
                aiResponseText.text = "SIMDA: I'm sorry, I didn't understand that.";
               
            }
        }
        else
        {
           
        }
    }

    public async Task ProvidePatientUpdate()
    {
        List<string> recommendations = patientDataManager.GetRecommendations(); 
        if (recommendations.Count > 0)
        {
            string response = "Here are some recommendations:\n";
            foreach (string recommendation in recommendations)
            {
                response += "- " + recommendation + "\n";
            }

            response += "\nThese recommendations are based on the following abnormal values:\n";
            foreach (var data in patientDataManager.dataElements)
            {
                if (icuKnowledgeBank.thresholds.ContainsKey(data.Key) && icuKnowledgeBank.thresholds[data.Key].IsAbnormal(float.Parse(data.Value.text)))
                {
                    response += $"- {data.Key}: {data.Value.text}\n";
                }
            }

            
           aiResponseText.text = response;
            await RespondWithText(response);
            ShowNotification();
        }
        else
        {
            string noAbnormalitiesMessage = "All patient data is within normal ranges.";
            aiResponseText.text = noAbnormalitiesMessage;
            await RespondWithText(noAbnormalitiesMessage);
            HideNotification();
        }
    }

    private void ShowNotification()
    {
        if (notificationIndicator != null)
        {
            notificationIndicator.SetActive(true);
        }
    }

    private void HideNotification()
    {
        if (notificationIndicator != null)
        {
            notificationIndicator.SetActive(false);
        }
    }

    


    private bool IsDirectDataRequest(string query)
    {
        string[] directDataKeywords = {
        "what is the patient's", "alt", "ast", "tell me the patient's", "genetic risk factors", "ddimer",
        "allergies", "show the patient's", "creatinine", "real-time", "heart rate", "blood pressure",
        "oxygen saturation", "pao2", "wbc", "blood volume", "systolic bp", "viral load", "comorbidities",
        "ph", "paco2", "crp", "family history", "patient name", "age", "gender", "insurance details",
        "contact info", "temperature", "diastolic bp", "mean arterial pressure", "ecg", "co2",
        "respiratory rate","patient history","chief complaint","symptoms","relevant history","past medical history","physical exam", "imaging","assessment and plan"
    };

        foreach (string keyword in directDataKeywords)
        {
            if (query.ToLower().Contains(keyword.ToLower()))
            {
                return true;
            }
        }
        return false;
    }

    private string ExtractDataType(string query)
    {
        
        Dictionary<string, string> dataTypeMappings = new Dictionary<string, string>
    {
        { "heart rate", "heart rate" },
        { "blood pressure", "blood pressure" },
        { "temperature", "temperature" },
        { "oxygen saturation", "oxygen saturation" },
        { "respiratory rate", "respiratory rate" },
        { "systolic bp", "systolic bp" },
        { "diastolic bp", "diastolic bp" },
        {"ecg" ,"ecg"},
        {"co2" ,"co2"},
        {"mean arterial pressure" ,"mean arterial pressure"},
        {"blood volume" ,"blood volume"},
        {"patient name" ,"patient name"},
        {"age" ,"age"},
        {"gender" ,"gender"},
        {"contact info" ,"contact info"},
        {"insurance details", "insurance details"},
        {"comorbidities" ,"comorbidities"},
        {"family history" ,"family history"},
        {"allergies" ,"allergies"},
        {"genetic risk factors" ,"genetic risk factors"},
        {"wbc", "wbc"},
        {"crp" ,"crp"},
        {"alt", "alt"},
        {"ast" ,"ast"},
        {"pao2","pao2"},
        {"ddimer" ,"ddimer"},
        {"creatinine" ,"creatinine"},
        {"paco2" ,"paco2"},
        {"ph" ,"ph"},
        {"viral load" ,"viral load"},
        { "chief complaint", "Chief Complaint" },
        { "symptoms", "Symptoms" },
        { "relevant history", "Relevant History" },
        { "past medical history", "Past Medical History" },
        { "physical exam", "Physical Exam" },
        { "imaging", "Imaging" },
        { "assessment and plan", "Assessment and Plan" },
        {"patient history", "patient history" }
       
       
        
    };

        foreach (var entry in dataTypeMappings)
        {
            if (query.ToLower().Contains(entry.Key))
            {
                return entry.Value;
            }
        }

        return string.Empty;  
    }


    private bool IsContextualQuestion(string query)
    {
        string[] contextualPhrases = { "what if", "why is", "what happens if", "could it mean", "if the" };

        foreach (string phrase in contextualPhrases)
        {
            if (query.ToLower().Contains(phrase))
            {
                return true;
            }
        }
        return false;
    }



