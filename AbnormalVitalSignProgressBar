    void RenderVitalSigns()
    {
        foreach (var render in vitalSignRenderObjects)
        {
            var metric = FindMatchingMetric(render.name);
            if (metric == null)
            {
                
                continue;
            }

            string currentState = "Normal";

            
            if (metric is MultiMetricProgressBar.BloodPressureMetric bpMetric)
            {
                string systolicValue = MultiMetricProgressBar.ExtractNumeric(bpMetric.systolicBP.text);
                string diastolicValue = MultiMetricProgressBar.ExtractNumeric(bpMetric.diastolicBP.text);

                if (float.TryParse(systolicValue, out float systolic) && float.TryParse(diastolicValue, out float diastolic))
                {
                    if (systolic > bpMetric.maxLimitSystolic || diastolic > bpMetric.maxLimitDiastolic)
                        currentState = "High";
                    else if (systolic < bpMetric.minLimitSystolic || diastolic < bpMetric.minLimitDiastolic)
                        currentState = "Low";
                    else
                        currentState = "Normal";
                }
            }
            else
            {
                float value = metric.GetValue();
                if (value > metric.maxLimit) currentState = "High";
                else if (value < metric.minLimit) currentState = "Low";
            }

            if (currentState != render.lastState)
            {
                if (render.lastState == "High") StartCoroutine(ReverseRender(render.highRenderObjects));
                else if (render.lastState == "Low") StartCoroutine(ReverseRender(render.lowRenderObjects));
                else if (render.lastState == "Normal") StartCoroutine(ReverseRender(render.normalRenderObjects));

                if (currentState == "High") StartCoroutine(SequentialRender(render.highRenderObjects));
                else if (currentState == "Low") StartCoroutine(SequentialRender(render.lowRenderObjects));
                else if (currentState == "Normal") StartCoroutine(SequentialRender(render.normalRenderObjects));

                render.lastState = currentState;
            }
        }
    }


    void RenderCombinations()
    {
        Dictionary<int, List<CombinationRender>> tieredCombinations = new Dictionary<int, List<CombinationRender>>();

        
        foreach (var combination in combinationRenderObjects)
        {
            if (!tieredCombinations.ContainsKey(combination.tier))
                tieredCombinations[combination.tier] = new List<CombinationRender>();
            tieredCombinations[combination.tier].Add(combination);
        }

        foreach (var tier in tieredCombinations.Keys)
        
        
        for (int tier = 6; tier >= 2; tier--)
        {
            if (tieredCombinations.ContainsKey(tier))
            {
                bool tierTriggered = false;

                foreach (var combination in tieredCombinations[tier])
                {
                  
                    if (EvaluateCombination(combination.combinationKey))
                    {
                        tierTriggered = true;
                        
                        StartCoroutine(SequentialRender(combination.combinationObjects));
                        if (combination.clinicalSignificanceText != null)
                        {
                            combination.clinicalSignificanceText.text = $"{combination.name}: Combination triggered!";
                            combination.clinicalSignificanceText.gameObject.SetActive(true);
                        }
                    }
                    else
                    {
                        if (combination.clinicalSignificanceText != null)
                        {
                           
                            combination.clinicalSignificanceText.text = "";
                            combination.clinicalSignificanceText.gameObject.SetActive(false);
                        }
                    }
                }

                if (tierTriggered) break; 
            }
        }
    }



