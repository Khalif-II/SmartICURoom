    IEnumerator SequentialRender(GameObject[] objectsToRender)
    {
        foreach (var obj in objectsToRender)
        {
            if (obj == null) continue;

            ValidateParentActivation(obj);

            if (!obj.activeSelf)
                obj.SetActive(true);

            var renderer = obj.GetComponent<Renderer>();
            if (renderer != null && !renderer.enabled)
                renderer.enabled = true;

            yield return new WaitForSeconds(showInterval);
        }
    }

    IEnumerator ReverseRender(GameObject[] objectsToHide)
    {
        for (int i = objectsToHide.Length - 1; i >= 0; i--)
        {
            var obj = objectsToHide[i];
            if (obj == null) continue;

            if (obj.activeSelf)
                obj.SetActive(false);

            yield return new WaitForSeconds(hideInterval);
        }
    }

    void ValidateParentActivation(GameObject obj)
    {
        Transform parent = obj.transform.parent;
        while (parent != null)
        {
            if (!parent.gameObject.activeSelf)
                parent.gameObject.SetActive(true);

            parent = parent.parent;
        }
    }

    MultiMetricProgressBar.Metric FindMatchingMetric(string name)
    {
        
        var metric = multiMetricProgressBar.metrics.Find(m =>
            string.Equals(m.name.Trim(), name.Trim(), System.StringComparison.OrdinalIgnoreCase));
        if (metric != null) return metric;

        
        var bpMetric = multiMetricProgressBar.bloodPressureMetrics.Find(m =>
            string.Equals(m.name.Trim(), name.Trim(), System.StringComparison.OrdinalIgnoreCase));
        if (bpMetric != null) return bpMetric;

        
        if (string.Equals(name.Trim(), "Mean Arterial Pressure", System.StringComparison.OrdinalIgnoreCase))
        {
            var systolicBPMetric = multiMetricProgressBar.bloodPressureMetrics.Find(m => m.systolicBP != null);
            var diastolicBPMetric = multiMetricProgressBar.bloodPressureMetrics.Find(m => m.diastolicBP != null);

            if (systolicBPMetric != null && diastolicBPMetric != null)
            {
                return new DynamicMetric(
                    name: "Mean Arterial Pressure",
                    baseline: 93f, 
                    minLimit: 60f,
                    maxLimit: 120f,
                    calculateValue: () =>
                    {
                        string systolicValue = MultiMetricProgressBar.ExtractNumeric(systolicBPMetric.systolicBP.text);
                        string diastolicValue = MultiMetricProgressBar.ExtractNumeric(diastolicBPMetric.diastolicBP.text);

                        if (float.TryParse(systolicValue, out float systolic) && float.TryParse(diastolicValue, out float diastolic))
                        {
                            return (systolic + 2 * diastolic) / 3f;
                        }
                        return 93f; 
                    }
                );
            }
        }

        return null; 
    }

    public class DynamicMetric : MultiMetricProgressBar.Metric
{
    private readonly System.Func<float> calculateValue;

    public DynamicMetric(string name, float baseline, float minLimit, float maxLimit, System.Func<float> calculateValue)
    {
        this.name = name;
        this.baseline = baseline;
        this.minLimit = minLimit;
        this.maxLimit = maxLimit;
        this.calculateValue = calculateValue;
    }

    public override float GetValue()
    {
        return calculateValue();
    }
}



    bool IsMetricHigh(string metricName)
    {
        if (metricName == "Blood Pressure")
        {
            
            float systolic = GetSystolicBloodPressure();
            float diastolic = GetDiastolicBloodPressure();

            if (systolic < 0 || diastolic < 0)
            {
                
                return false; 
            }

            
            float meanArterialPressure = (systolic + 2 * diastolic) / 3;
           

            
            float desiredHighThreshold = 100f; 

            
            return meanArterialPressure > desiredHighThreshold;
        }

        
        var metric = FindMatchingMetric(metricName);
        if (metric == null)
        {
          
            return false;
        }

        float value = metric.GetValue();
        
        return value > metric.maxLimit;
    }

    bool IsMetricLow(string metricName)
    {
        if (metricName == "Blood Pressure")
        {
            
            float systolic = GetSystolicBloodPressure();
            float diastolic = GetDiastolicBloodPressure();

            if (systolic < 0 || diastolic < 0)
            {
               
                return false; 
            }

            
            float meanArterialPressure = (systolic + 2 * diastolic) / 3;
            

            
            float desiredLowThreshold = 70f; 

            
            return meanArterialPressure < desiredLowThreshold;
        }

        
        var metric = FindMatchingMetric(metricName);
        if (metric == null)
        {
            
            return false;
        }

        float value = metric.GetValue();
       
        return value < metric.minLimit;
    }

    float GetSystolicBloodPressure()
    {
        var bloodPressureMetric = multiMetricProgressBar.bloodPressureMetrics.Find(m => m.name == "Blood Pressure");
        if (bloodPressureMetric != null && bloodPressureMetric.systolicBP != null)
        {
            string systolicValue = MultiMetricProgressBar.ExtractNumeric(bloodPressureMetric.systolicBP.text);
            if (float.TryParse(systolicValue, out float systolic))
                return systolic;
        }

       
        return -1; 
    }

    float GetDiastolicBloodPressure()
    {
        var bloodPressureMetric = multiMetricProgressBar.bloodPressureMetrics.Find(m => m.name == "Blood Pressure");
        if (bloodPressureMetric != null && bloodPressureMetric.diastolicBP != null)
        {
            string diastolicValue = MultiMetricProgressBar.ExtractNumeric(bloodPressureMetric.diastolicBP.text);
            if (float.TryParse(diastolicValue, out float diastolic))
                return diastolic;
        }

        
        return -1; 
    }


