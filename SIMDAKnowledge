def generate_embeddings(knowledge_bank, embedding_model):
    texts = []
    try:
        if isinstance(knowledge_bank, list):
            for entry in knowledge_bank:
                if isinstance(entry, dict) and 'content' in entry:
                    processed_text = preprocess_content(entry['content'])
                    if processed_text:
                        texts.append(processed_text)
                
                    
            if not texts:
                raise ValueError("No relevant 'content' fields found in list entries.")
        
        elif isinstance(knowledge_bank, dict):
            for key, section in knowledge_bank.items():
                if isinstance(section, list):
                    for entry in section:
                        if isinstance(entry, dict) and 'content' in entry:
                            processed_text = preprocess_content(entry['content'])
                            if processed_text:
                                texts.append(processed_text)
            if not texts:
                raise ValueError("No relevant 'content' fields found in dictionary entries.")
        
        else:
            raise ValueError("Unexpected structure for knowledge_bank. It should be a list of dictionaries or a dictionary with nested lists.")
        
    except Exception as e:
        raise ValueError("Invalid JSON structure. Could not extract text content for embedding.")

   
    embeddings = embedding_model.encode(texts, convert_to_numpy=True, show_progress_bar=True)
    return embeddings

def search_knowledge_bank(query_embedding, knowledge_embeddings, knowledge_bank, top_k=7):  
    cos_similarities = util.cos_sim(query_embedding, knowledge_embeddings)[0]
    top_results = np.argsort(-cos_similarities)[:top_k]
    closest_matches = [knowledge_bank[i] for i in top_results]
    return closest_matches

def is_simple_query(closest_matches):
    return len(closest_matches) > 0 and closest_matches[0].get('relevance', 0) > 0.8

def create_context_from_matches(closest_matches):
    context = "\n".join([match['content'] for match in closest_matches if 'content' in match])
    return context

